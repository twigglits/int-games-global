<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MovieSearch.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit.v3 test projects are executables that host Microsoft.Testing.Platform. -->
    <OutputType>Exe</OutputType>
    <!-- Test names read as sentences, so the doc-comment rule does not apply. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MovieSearch.Api\MovieSearch.Api.csproj" />
    <ProjectReference Include="..\..\src\MovieSearch.Application\MovieSearch.Application.csproj" />
    <ProjectReference Include="..\..\src\MovieSearch.Domain\MovieSearch.Domain.csproj" />
    <ProjectReference Include="..\..\src\MovieSearch.Infrastructure\MovieSearch.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.1.0" />
  </ItemGroup>

</Project>
