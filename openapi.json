        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {
      "name": "Movie Search Platform"
    },
    "description": "Semantic search over a movie catalogue.\n\nThe API translates a natural language query into a vector, narrows the catalogue with the metadata filters supplied, and returns the closest matches with their similarity scores. The search itself runs on a Python MCP server backed by PostgreSQL with pgvector.\n\n**Getting a token.** Every `/api/v1/*` route needs a bearer token. Post your client id and secret to `/auth/token`, then send the returned token as `Authorization: Bearer <token>`.\n\n**Roles.** A `reader` token may search and read movies. A `admin` token may do that and also read `/api/v1/stats`.\n\n**Rate limit.** 60 requests per minute per client. A rejected request answers 429 and carries a `Retry-After` header.",
    "license": {
      "name": "MIT"
    },
    "title": "Intelligent Movie Search API",
    "version": "1.0.0"
  },
  "openapi": "3.1.1",
  "paths": {
    "/api/v1/movies/genres": {
      "get": {
        "description": "The values returned here are the accepted values of the `genre` filter.",
        "operationId": "ListGenres",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenresResponse"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized"
          },
          "502": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Gateway"
          }
        },
        "security": [
          {}
        ],
        "summary": "List every genre in the catalogue.",
        "tags": [
          "Movies"
        ]
      }
    },
    "/api/v1/movies/search": {
      "get": {
        "description": "Runs a semantic vector search over the catalogue and narrows it with the metadata filters supplied. The description is matched by meaning; every filter is an exact match. Results are ordered by similarity, best first.",
        "operationId": "SearchMovies",
        "parameters": [
          {
            "example": "sci-fi films directed by James Cameron",
            "in": "query",
            "name": "q",
            "schema": {
              "type": "string"
            }
          },
          {
            "example": 10,
            "in": "query",
            "name": "top_k",
            "schema": {
              "format": "int32",
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ]
            }
          },
          {
            "example": "Action",
            "in": "query",
            "name": "genre",
            "schema": {
              "type": "string"
            }
          },
          {
            "example": 7.5,
            "in": "query",
            "name": "min_imdb_rating",
            "schema": {
              "format": "double",
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
              "type": [
                "number",
                "string"
              ]
            }
          },
          {
            "example": "PG-13",
            "in": "query",
            "name": "mpaa_rating",
            "schema": {
              "type": "string"
            }
          },
          {
            "example": 1990,
            "in": "query",
            "name": "decade",
            "schema": {
              "format": "int32",
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "502": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Gateway"
          }
        },
        "security": [
          {}
        ],
        "summary": "Search movies with a natural language description.",
        "tags": [
          "Movies"
        ]
      }
    },
    "/api/v1/movies/{id}": {
      "get": {
        "operationId": "GetMovieById",
        "parameters": [
          {
            "example": "3f1b9c48-1c2e-4a5f-9f3a-6d1c0b2e7a41",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MovieResponse"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "502": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Gateway"
          }
        },
        "security": [
          {}
        ],
        "summary": "Fetch one movie by its identifier.",
        "tags": [
          "Movies"
        ]
      }
    },
    "/api/v1/movies/{id}/similar": {
      "get": {
        "description": "Compares the stored vector of the given movie against every other vector. The movie itself is never in the result.",
        "operationId": "GetSimilarMovies",
        "parameters": [
          {
            "example": "3f1b9c48-1c2e-4a5f-9f3a-6d1c0b2e7a41",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "example": 10,
            "in": "query",
            "name": "top_k",
            "schema": {
              "format": "int32",
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimilarMoviesResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "502": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Gateway"
          }
        },
        "security": [
          {}
        ],
        "summary": "Fetch the movies closest in meaning to one movie.",
        "tags": [
          "Movies"
        ]
      }
    },
    "/api/v1/stats": {
      "get": {
        "description": "Requires the `admin` role. A `reader` token receives 403.",
        "operationId": "GetDatasetStats",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsResponse"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Forbidden"
          },
          "502": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Gateway"
          }
        },
        "security": [
          {}
        ],
        "summary": "Summary statistics for the loaded dataset.",
        "tags": [
          "Statistics"
        ]
      }
    },
    "/auth/token": {
      "post": {
        "description": "Implements the OAuth 2.0 client-credentials grant. Send the client id and secret in a JSON body. The returned token goes in the `Authorization` header as `Bearer <token>` on every `/api/v1/*` request.",
        "operationId": "IssueToken",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "summary": "Exchange client credentials for an access token.",
        "tags": [
          "Authentication"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:58080/"
    }
  ],
  "tags": [
    {
      "description": "Obtaining an access token.",
      "name": "Authentication"
    },
    {
      "description": "Searching and reading movies.",
      "name": "Movies"
    },
    {
      "description": "Facts about the loaded dataset. Requires the admin role.",
      "name": "Statistics"
    }
  ]
}
