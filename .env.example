# ---------------------------------------------------------------------------
# Movie Search Platform — local environment
#
# Copy this file to `.env` before you start the platform:
#     cp .env.example .env
#
# The values below are development defaults. They are safe for a local machine.
# Replace every secret before you deploy anywhere else. In AWS these same values
# come from AWS Secrets Manager. See terraform/README.md.
# ---------------------------------------------------------------------------

# --- PostgreSQL 16 + pgvector ------------------------------------------------
POSTGRES_USER=movies
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=movies
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host port that maps to the container port 5432. Change it if 5432 is in use.
POSTGRES_HOST_PORT=5432

# --- Embedding model service (Text Embeddings Inference) ---------------------
# BAAI/bge-base-en-v1.5 produces 768-dimension vectors.
# If you change the model, you must also change EMBEDDING_DIM and the
# `vector(768)` column in database/migrations/V1__initial_schema.sql.
EMBEDDING_MODEL_ID=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768
EMBEDDINGS_URL=http://embeddings:80
EMBEDDINGS_HOST_PORT=8001
# BGE models expect this instruction in front of a search query, and no
# instruction in front of a stored document. See README "Embedding Strategy".
# Quoted so that the value survives both Docker Compose and `source .env`.
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages:"
EMBEDDING_DOC_PREFIX=

# --- Data pipeline -----------------------------------------------------------
PIPELINE_VERSION=1.0.0
PIPELINE_BATCH_SIZE=32
PIPELINE_LOG_LEVEL=INFO
# Set to `true` to re-embed every row even when its text did not change.
PIPELINE_FORCE_REEMBED=false
# Last year the Vega movies dataset covers. The source encodes two-digit years,
# so any later year is a rollover and gets shifted back one century.
PIPELINE_MAX_RELEASE_YEAR=2011

# --- Python MCP server -------------------------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=8000
# `sse` for local development, `http` (streamable HTTP) for production.
MCP_TRANSPORT=sse
MCP_LOG_LEVEL=INFO
MCP_DB_POOL_MIN=2
MCP_DB_POOL_MAX=10
MCP_HOST_PORT=8000

# --- .NET 10 Web API ---------------------------------------------------------
API_HOST_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# JWT signing key. Must be at least 32 bytes. Generate a new one with:
#     openssl rand -base64 48
Auth__SigningKey=local-development-signing-key-change-me-0123456789abcdef
Auth__Issuer=https://movie-search.local
Auth__Audience=movie-search-api
Auth__AccessTokenLifetimeMinutes=60

# Client-credentials clients. Rotate these before any non-local use.
READER_CLIENT_ID=reader-client
READER_CLIENT_SECRET=reader-secret-change-me
ADMIN_CLIENT_ID=admin-client
ADMIN_CLIENT_SECRET=admin-secret-change-me

# --- Observability -----------------------------------------------------------
# Both services export OTLP over HTTP, so the endpoint is the 4318 receiver.
# Docker Compose sets this per service; the value here is for a service run by
# hand outside Compose.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
JAEGER_HOST_PORT=16686
# Published so that a service run outside Compose can export to Jaeger.
OTLP_GRPC_HOST_PORT=4317
OTLP_HTTP_HOST_PORT=4318
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Embedding Atlas (bonus) -------------------------------------------------
ATLAS_HOST_PORT=7000
# Rows to draw. 0 means every row, which is comfortable at this dataset size.
ATLAS_SAMPLE_SIZE=0
